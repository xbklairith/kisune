# Documentation and planning (project-specific); decision records are committed
/docx/*
!/docx/decisions/

# Example plugins (reference only)
examples/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Node modules (if any MCP servers use them)
node_modules/

# Python (if any scripts use Python)
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs
*.log
logs/

# Plugin eval run output
dev-workflow/evals/results/
trading/evals/results/

# Eval fixtures keep input documents in docs/; a global ignore of `docs` must
# not hide them (tools/check.py fails when a rule outside the repo does)
!/dev-workflow/evals/*/docs/
!/trading/evals/*/docs/
